{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finnie",
  "version": "0.1.0",
  "identifier": "dev.apexearth.finnie",
  "build": {
    "devUrl": "http://127.0.0.1:5178",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run web",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Finnie",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
